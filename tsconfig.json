{
  "compilerOptions": {
    // Node ejecuta los .ts directamente (borra los tipos), así que tsc solo verifica tipos
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Solo sintaxis que Node puede "borrar" (sin enums ni parameter properties)
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.ts"]
}
